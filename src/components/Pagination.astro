---
interface PageInfo {
  currentPage: number;
  total: number;
  url: {
    prev: string;
    next: string;
  };
}

interface PaginationLink {
  url: string;
  page: number | string;
  isCurrent: boolean;
}

interface Props {
  page: PageInfo;
  post_num: number;
  paginationLinks: PaginationLink[];
}

const { page, post_num, paginationLinks } = Astro.props;

const isLastPage = page.currentPage >= Math.ceil(page.total / post_num);
const totalPages = Math.ceil(page.total / post_num);

const getPreviousPageUrl = (_: number, prevUrl: string) => prevUrl;
const getPageUrl = (link: PaginationLink) => link.url;
---

<div id="pagination-container" class="flex flex-col items-center gap-3 py-4">
  <!-- Post count info -->
  <p class="text-xs tracking-wide" style="color: inherit; opacity: 0.4;">
    Page <strong>{page.currentPage}</strong> of <strong>{totalPages}</strong>
    &nbsp;&middot;&nbsp; {page.total} posts
  </p>

  <!-- Page navigation -->
  <nav class="flex items-center gap-1" aria-label="Pagination">
    <!-- Previous arrow -->
    {
      page.currentPage > 1 ? (
        <a
          href={getPreviousPageUrl(page.currentPage, page.url.prev)}
          class="pagination-arrow"
          aria-label="Previous page"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        </a>
      ) : (
        <span class="pagination-arrow disabled" aria-disabled="true">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        </span>
      )
    }

    <!-- Page numbers -->
    {
      paginationLinks.map((link) =>
        typeof link.page === 'number' ? (
          link.isCurrent ? (
            <span class="pagination-page current" aria-current="page">
              {link.page}
            </span>
          ) : (
            <a href={getPageUrl(link)} class="pagination-page">
              {link.page}
            </a>
          )
        ) : (
          <span class="pagination-ellipsis">&hellip;</span>
        )
      )
    }

    <!-- Next arrow -->
    {
      !isLastPage ? (
        <a href={page.url.next} class="pagination-arrow" aria-label="Next page">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
      ) : (
        <span class="pagination-arrow disabled" aria-disabled="true">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </span>
      )
    }
  </nav>
</div>

<style is:global>
  /* High-specificity ID rules beat the global a:visited rule in every scenario */
  #pagination-container a.pagination-page,
  #pagination-container a.pagination-page:link,
  #pagination-container a.pagination-page:visited,
  #pagination-container a.pagination-page:active {
    color: rgb(168 162 158); /* stone-400 */
  }

  html.dark #pagination-container a.pagination-page,
  html.dark #pagination-container a.pagination-page:link,
  html.dark #pagination-container a.pagination-page:visited,
  html.dark #pagination-container a.pagination-page:active {
    color: rgb(113 113 122); /* zinc-500 */
  }

  #pagination-container a.pagination-page:hover {
    color: rgb(28 25 23); /* stone-900 */
  }

  html.dark #pagination-container a.pagination-page:hover {
    color: rgb(244 244 245); /* zinc-100 */
  }

  #pagination-container a.pagination-arrow,
  #pagination-container a.pagination-arrow:link,
  #pagination-container a.pagination-arrow:visited,
  #pagination-container a.pagination-arrow:active {
    color: rgb(120 113 108); /* stone-500 */
  }

  html.dark #pagination-container a.pagination-arrow,
  html.dark #pagination-container a.pagination-arrow:link,
  html.dark #pagination-container a.pagination-arrow:visited,
  html.dark #pagination-container a.pagination-arrow:active {
    color: rgb(113 113 122); /* zinc-500 */
  }

  #pagination-container a.pagination-arrow:hover {
    color: rgb(225 107 94); /* terracotta-500-ish */
    border-color: rgb(225 107 94);
  }

  html.dark #pagination-container a.pagination-arrow:hover {
    color: rgb(234 152 140); /* terracotta-400 */
    border-color: rgb(234 152 140);
  }
</style>

<style>
  .pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .pagination-page.current {
    font-weight: 700;
    color: #e16c5a; /* terracotta-600 */
  }

  :global(html.dark) .pagination-page.current {
    color: #ea988c; /* terracotta-400 */
  }

  .pagination-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 9999px;
    border: 1px solid rgb(214 211 209); /* stone-300 */
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  :global(html.dark) .pagination-arrow {
    border-color: rgb(63 63 70); /* zinc-700 */
  }

  .pagination-arrow.disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }

  .pagination-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    font-size: 0.875rem;
    color: rgb(214 211 209); /* stone-300 */
    user-select: none;
  }

  :global(html.dark) .pagination-ellipsis {
    color: rgb(63 63 70); /* zinc-700 */
  }
</style>
