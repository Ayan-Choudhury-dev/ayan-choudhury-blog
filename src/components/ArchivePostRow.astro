---
import type { CollectionEntry } from 'astro:content';

type Props = {
  post: CollectionEntry<'blog'>;
  style?: string;
};

const { post, style } = Astro.props;

function readTime(body: string | undefined): string {
  if (!body) return '1 min';
  const mins = Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));
  return `${mins} min`;
}

function formatDate(date: Date): string {
  return date.toLocaleDateString('en-US', { month: 'short', day: '2-digit' });
}
---

<li class="post-row border-b border-foreground/20 last:border-0" data-tags={post.data.tags?.join(',') || ''} style={style}>
  <a
    href={`/blog/${post.id}`}
    class="group relative grid grid-cols-[4rem_1fr_3.5rem] sm:grid-cols-[5rem_1fr_4rem] items-baseline gap-x-4 py-4 -mx-3 px-3 rounded-sm transition-colors duration-150 cursor-pointer hover:bg-accent-color/[0.04] no-underline"
  >
    <!-- Accent left border flash on hover -->
    <span
      class="absolute left-0 top-2 bottom-2 w-[2px] rounded-full bg-accent-color scale-y-0 group-hover:scale-y-100 transition-transform duration-200 origin-center"
    ></span>

    <!-- Date -->
    <span class="font-sans text-sm text-muted-foreground tabular-nums shrink-0 pt-0.5">
      {formatDate(new Date(post.data.date))}
    </span>

    <!-- Title + tags -->
    <span class="flex flex-col gap-1.5 min-w-0">
      <span
        class="font-serif text-[0.95rem] leading-snug text-foreground group-hover:text-accent-color transition-colors duration-150"
      >
        {post.data.title}
      </span>
      {
        post.data.tags && post.data.tags.length > 0 && (
          <span class="flex flex-wrap gap-4">
            {post.data.tags.slice(0, 4).map((tag) => (
              <span class="font-mono text-sm font-mono text-accent-color/90 group-hover:text-accent-color transition-colors duration-150">
                #{tag}
              </span>
            ))}
          </span>
        )
      }
    </span>

    <!-- Read time -->
    <span class="font-mono text-xs text-muted-foreground text-right tabular-nums">
      {readTime(post.body)}
    </span>
  </a>
</li>
