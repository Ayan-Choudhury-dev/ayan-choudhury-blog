---
import type { CollectionEntry } from 'astro:content';
import { readingTime, shouldOptimizeImage } from '@lib/utils';
import Image from 'astro/components/Image.astro';

type Props = {
  nextPost: CollectionEntry<'blog'>;
};

const { nextPost } = Astro.props;

const useOptimizedImage =
  nextPost.data.cover && typeof nextPost.data.cover === 'object' && 'src' in nextPost.data.cover
    ? shouldOptimizeImage(nextPost.data.cover.src)
    : true;
---

<div class="mt-16 pt-8 border-t border-border">
  <a
    href={`/blog/${nextPost.id}`}
    class="group flex items-stretch text-inherit no-underline"
    aria-label={`Read next: ${nextPost.data.title}`}
  >
    <!-- Card -->
    <div
      class="relative flex flex-1 h-[200px] max-[540px]:h-[160px] overflow-hidden rounded-xl border border-border bg-card
             shadow-[0_25px_50px_-12px_rgba(0,0,0,0.08)] dark:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]
             dark:[background-image:var(--noise-texture)]
             transition-[border-color,box-shadow] duration-[350ms] ease-in
             group-hover:border-accent-color/40 group-hover:shadow-[0_6px_28px_rgba(0,0,0,0.07)]
             dark:group-hover:shadow-[0_8px_36px_rgba(0,0,0,0.45)]
             after:content-[''] after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0
             after:bg-accent-color after:transition-[width] after:duration-[450ms]
             after:[transition-timing-function:cubic-bezier(0.4,0,0.2,1)] after:rounded-b-xl
             group-hover:after:w-full"
    >
      <!-- Image -->
      <div class="relative w-[38%] max-w-[210px] max-[540px]:w-[36%] shrink-0 overflow-hidden">
        {
          nextPost.data.cover && 'src' in nextPost.data.cover ? (
            useOptimizedImage ? (
              <Image
                src={nextPost.data.cover}
                quality="mid"
                width={400}
                height={300}
                class="w-full h-full object-cover block transition-transform duration-[550ms] [transition-timing-function:cubic-bezier(0.4,0,0.2,1)] group-hover:scale-105"
                alt={nextPost.data.title}
              />
            ) : (
              <img
                src={nextPost.data.cover.src}
                width="400"
                height="300"
                class="w-full h-full object-cover block transition-transform duration-[550ms] [transition-timing-function:cubic-bezier(0.4,0,0.2,1)] group-hover:scale-105"
                alt={nextPost.data.title}
              />
            )
          ) : (
            <img
              src="https://images.unsplash.com/photo-1512236258305-32fb110fdb01?w=800&auto=format&fit=crop&q=60"
              width="400"
              height="300"
              class="w-full h-full object-cover block transition-transform duration-[550ms] [transition-timing-function:cubic-bezier(0.4,0,0.2,1)] group-hover:scale-105"
              alt=""
              aria-hidden="true"
            />
          )
        }
      </div>

      <!-- Content -->
      <div
        class="flex-1 flex flex-col justify-between py-6 px-7 max-[540px]:py-[1.125rem] max-[540px]:px-5 gap-2 min-w-0"
      >
        <p class="m-0 text-xs font-sans tracking-[0.2em] uppercase text-accent-color opacity-80">
          Read next
        </p>
        <h3
          class="flex-1 m-0 font-serif text-[1.15rem] max-[540px]:text-base font-normal leading-normal text-accent-color line-clamp-3 max-[540px]:line-clamp-4 transition-colors duration-300"
        >
          {nextPost.data.title}
        </h3>
        <div class="flex items-center justify-between mt-1">
          <span class="text-sm font-sans tracking-[0.03em] text-foreground opacity-[0.45]">
            {readingTime(nextPost.body ?? '')}
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4 shrink-0 text-foreground transition-[transform,opacity,color] duration-300 group-hover:translate-x-[5px] group-hover:opacity-100 group-hover:text-accent-color"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
      </div>
    </div>
  </a>
</div>
