---
// Component Imports
import { type CollectionEntry, render } from 'astro:content';
import PostHeader from './PostHeader.astro';
import TagLinks from './TagLinks.astro';

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<div
  class="postcard mb-10 shadow-black/10 dark:shadow-zinc-950 shadow-2xl bg-card rounded-2xl overflow-hidden"
>
  <PostHeader entry={entry} />
  <!-- todo:concat the content and add a read more button -->
  <article class="px-4 sm:px-12 mb-16">
    <Content />
    <TagLinks post={entry} />
  </article>
</div>
