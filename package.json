{
  "name": "astro-nano",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run watch:prettier\" \"npm run watch:dev\"",
    "watch:prettier": "onchange \"**/*.{js,ts,astro,mdx,json,css}\" -- prettier --write --ignore-unknown {{changed}}",
    "watch:dev": "astro dev --host",
    "dev": "astro dev --host",
    "dev:network": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdoc": "^0.12.9",
    "@astrojs/mdx": "^4.0.8",
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^6.0.0",
    "@astrojs/ts-plugin": "^1.10.4",
    "@astrojs/vercel": "^8.0.6",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/lora": "^5.0.16",
    "@keystatic/astro": "^5.0.0",
    "@keystatic/core": "^0.5.26",
    "@tailwindcss/typography": "^0.5.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.2.5",
    "clsx": "^2.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "lucide-astro": "^0.486.0",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.2",
    "node-html-parser": "^6.1.13",
    "onchange": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.3",
    "tailwind-merge": "^2.2.2",
    "tailwindcss": "^3.4.1",
    "tippy.js": "^6.3.7",
    "typescript": "^5.4.2",
    "vercel": "^39.0.2"
  },
  "devDependencies": {
    "prettier": "3.3.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
