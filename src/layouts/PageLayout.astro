---
import Head from '@components/Head.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE } from '@consts';
import Analytics from '@vercel/analytics/astro';

type Props = {
  title: string;
  description: string;
  image?: string;
};

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>

    <Head title={`${title} | ${SITE.NAME}`} description={description} image={image} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Analytics />

    <script>
      // oldpress — vintage print engine.
      // Dev: always on (instant aging + switcher pill, bottom-right).
      // Prod: opt-in only, via ?old=<theme>&ops=<seed>&opi=<intensity>
      import { press, autoPress } from '@lib/oldpress';
      if (import.meta.env.DEV) {
        // ?old= works in dev too; plain letterpress otherwise.
        autoPress() ?? press({ theme: 'letterpress' });
      } else {
        autoPress();
      }
    </script>
  </body>
</html>
