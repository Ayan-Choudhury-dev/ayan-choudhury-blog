---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import PostHeader from '@components/PostHeader.astro';
import TagLinks from '@components/TagLinks.astro';
import NextPost from '@components/NextPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, index) => {
    // Get the next post (if available)
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: { post, nextPost },
    };
  });
}

type Props = {
  post: CollectionEntry<'blog'>;
  nextPost: CollectionEntry<'blog'> | null;
};

const { post, nextPost } = Astro.props;
const { Content } = await post.render();

// Ensure description is always a string
const description = post.data.description || '';

// Get cover image if it exists
const coverImage = post.data.cover?.src;
---

<PageLayout title={post.data.title} description={description} image={coverImage}>
  <Container>
    <div class="mb-8">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 font-mono text-sm text-foreground/80 hover:text-foreground/70 transition-colors duration-150"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-3"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"></path>
        </svg>
        All posts
      </a>
    </div>

    <PostHeader entry={post} />

    <!-- Content of blog begins here -->
    <article class="mb-16 prose-lg">
      <Content />
      <TagLinks post={post} />
    </article>
    {
      nextPost && (
        <div class="px-4 mb-16">
          <NextPost nextPost={nextPost} />
        </div>
      )
    }
  </Container>
</PageLayout>

