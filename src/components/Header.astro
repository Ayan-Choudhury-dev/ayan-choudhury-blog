---
import Container from '@components/Container.astro';
import Link from '@components/Link.astro';
import { SITE } from '@consts';

// import tippy from 'tippy.js';
---

<header class="w-full py-6 mb-8 border-b border-border">
  <Container class="w-full max-w-2xl mx-auto">
    <div class="flex flex-nowrap gap-y-2 justify-between items-center" id="hero_container">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          <span class="text-accent-color dark:text-accent-color">{SITE.NAME}</span>
          <span
            id="tagline"
            class="block text-sm font-normal text-foreground dark:text-foreground hidden sm:block"
          >
            {SITE.TAGLINE}
          </span>
        </div>
      </Link>

      <div class="flex items-center gap-4">
        <!-- Theme toggle buttons (visibility controlled by CSS via Tailwind dark: variant) -->
        <button
          id="light-theme-button"
          aria-label="Light theme"
          class="group size-8 items-center justify-center rounded-full theme-toggle-btn hidden dark:flex border border-black/20 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300 ease-in-out"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
        </button>

        <button
          id="dark-theme-button"
          aria-label="Dark theme"
          class="group size-8 items-center justify-center rounded-full theme-toggle-btn flex dark:hidden border border-black/20 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 transition-colors duration-300 ease-in-out"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>

        <a
          href="/subscribe"
          aria-label="Subscribe to RSS"
          class="relative inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-lg font-semibold text-sm tracking-tight transition duration-200 ease-out overflow-hidden group no-underline"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-accent-color/5 to-accent-color/10 dark:from-white/10 dark:to-white/5 border border-accent-color/30 dark:border-white/20 rounded-lg transition duration-200 group-hover:border-accent-color/60 dark:group-hover:border-white/40"
          >
          </div>
          <div
            class="absolute inset-0 bg-accent-color/0 dark:bg-white/0 group-hover:bg-accent-color/5 dark:group-hover:bg-white/8 rounded-lg transition duration-200"
          >
          </div>

          <div class="relative flex items-center gap-1.5">
            <span class="text-accent-color dark:text-white font-bold tracking-wide hidden sm:inline"
              >SUBSCRIBE</span
            >
            <span class="text-accent-color dark:text-white font-bold sm:hidden">RSS</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-accent-color dark:text-white transition duration-200 group-hover:scale-110 group-hover:rotate-12"
            >
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </div>
        </a>
      </div>


    </div>
  </Container>
</header>
