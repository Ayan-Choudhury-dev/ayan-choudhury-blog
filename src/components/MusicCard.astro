---
import type { CollectionEntry } from "astro:content";
import Image from "astro/components/Image.astro";
import FormattedDate from "./FormattedDate.astro";
// import { Button } from "@/components/ui/button"

// Destructure props and prepare display variables
const { entry } = Astro.props;
const artist = entry.data.artist;
const track = entry.data.name.split(" - ")[0] || entry.data.name;
const isSpotify = entry.data.trackURL.includes("spotify.com");
const isYoutube = entry.data.trackURL.includes("youtube.com") || entry.data.trackURL.includes("youtu.be");
const typeLabel = entry.data.type === "album" ? "Album" : "Single";
const isAlbum = entry.data.type === "album";
---

<!--
  MusicCard Component
  - Album art on the left (square for albums, circle for singles)
  - Blurred background with gradient overlay
  - Date at top right
  - Album/Single label, track name, and artist left-aligned
  - 'Listen' button on the right with icon
  - Responsive, modern, and visually balanced
-->

<div
  class="relative flex flex-col md:flex-row items-center w-full max-w-2xl mx-auto min-h-[110px] rounded-2xl shadow-2xl overflow-hidden p-4 md:p-0 group"
  id="MusicCard Container"
>
  {/** Blurred album art as card background with gradient overlay for readability */}
  {entry.data.artURL && (
    <div class="absolute bottom-0 right-0 w-full h-full md:h-[40%] z-0">
      <img
        src={entry.data.artURL}
        alt={entry.data.name}
        class="w-full h-full object-cover blur-xl scale-110 brightness-[70%] saturate-[150%]"
        loading="lazy"
      />
    </div>
  )}

  {/** Album art: square for albums, circle for singles - full width on mobile */}
  <div class="relative z-10 flex items-center h-full w-full md:w-auto">
    <div class={`w-full md:w-40 flex-shrink-0 overflow-hidden border-white/10 shadow-2xl ${isAlbum ? "rounded-xl shadow-[4px_4px_rgba(150,_150,_150,_0.15),_8px_8px_rgba(150,_150,_150,_0.12),_12px_12px_rgba(150,_150,_150,_0.09),_16px_16px_rgba(150,_150,_150,_0.06)]" : "rounded-full shadow-xl shadow-black/30"}`}>
      {/** Album art image */}
      <img
        src={entry.data.artURL}
        alt={entry.data.name}
        class="w-full h-full object-cover aspect-square"
        loading="lazy"
      />
    </div>
  </div>

  {/** Card content: label, track, artist, date, and Listen button */}
  <div class="relative h-full w-full z-10 flex flex-1 flex-row p-4 md:pl-6 md:pr-4 items-end" id="Card Content">
    {/** Album/Single label, track name, and artist */}
    <div class="flex flex-col justify-center min-w-0 flex-1 h-full">
      {/** Date at top right */}
      <div class="text-xs text-white/50 mb-6 mt-2">
        <FormattedDate date={entry.data.date} />
      </div>

      {/** Album/Single label */}
      <div class="flex flex-row items-center gap-2 mb-1">
        <span class="text-xs font-bold py-0.5 rounded-xl text-white/90 backdrop-blur-sm tracking-wide">
          {typeLabel}
        </span>
      </div>
      {/** Track name */}
      <div id="trackname" class="text-lg font-bold text-white truncate">{track}</div>
      {/** Artist name */}
      <div id="artist" class="text-xs font-medium opacity-80 text-white/60 truncate">{artist}</div>
    </div>
    <div class="flex flex-col justify-end items-end h-full ml-4" id="Listenbuttoncontainer">
      
      {/** Listen button with icon depending on platform */}
      <a
        href={entry.data.trackURL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-1.5 text-sm rounded-xl border border-black/40 text-white bg-black/70 hover:bg-black/90 transition-colors shadow"
      >
        {isSpotify && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="flex-shrink-0"
          >
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
        )}
        {isYoutube && (
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="flex-shrink-0"
          >
            <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
          </svg>
        )}
        Listen
      </a>
    </div>
  </div>
</div>

<style>
  /* Grid view styles */
  @media (max-width: 768px) {
    #music-container[data-view="grid"] #MusicCard\ Container {
      flex-direction: column;
      height: auto;
      min-height: 0;
    }

    #music-container[data-view="grid"] #Card\ Content {
      padding: 1rem;
    }

    #music-container[data-view="grid"] #Listenbuttoncontainer {
      margin-left: 0;
      margin-top: 1rem;
      width: 100%;
    }

    #music-container[data-view="grid"] #Listenbuttoncontainer a {
      width: 100%;
      justify-content: center;
    }
  }
</style>