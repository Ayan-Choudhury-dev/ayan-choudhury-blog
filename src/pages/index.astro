---
import { getCollection } from 'astro:content';
import Container from '@components/Container.astro';
import PageLayout from '@layouts/PageLayout.astro';
import PostCardMini from '@components/PostCardMini.astro';
import Link from '@components/Link.astro';
import { SITE, HOME, SOCIALS } from '@consts';
import { MagicalSnippet } from '@components/MagicalSnippet';

const allPosts = await getCollection('blog');
const totalPosts = allPosts.filter((post) => !post.data.draft).length;

const blog = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

// Fetch all snippets — random selection happens client-side to work in static builds
const allSnippets = await getCollection('snippets');
const snippetTexts = allSnippets
  .filter((s) => !s.data.draft && s.body)
  .map((s) => s.body as string);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <!-- Identity + Hero -->
    <section class="mb-16 space-y-5">
      <MagicalSnippet
        client:load
        texts={snippetTexts.length > 0 ? snippetTexts : ['Explore a collection of thoughts, snippets, and daily observations.']}
      />
    </section>

    <!-- Divider -->
    <div class="border-t border-foreground/10 mb-16"></div>

    <!-- Posts -->
    <section class="animate space-y-10">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-xs font-semibold text-foreground/70 uppercase tracking-widest">
          Latest
        </h2>
        <Link href="/blog" aria-label="View all posts" underline={false}>
          <span
            class="text-xs font-mono text-foreground/40 hover:text-foreground/70 transition-colors duration-200 flex items-center gap-1.5"
          >
            All {totalPosts} entries
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-3"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </span>
        </Link>
      </div>

      <ul class="flex flex-col gap-12">
        {
          blog.map((post) => (
            <article>
              <PostCardMini entry={post} />
            </article>
          ))
        }
      </ul>
    </section>

    <!-- Footer contact -->
    <footer class="mt-24 pt-8 border-t border-foreground/10">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span class="text-xs font-mono text-foreground/35">say hello —</span>
        {
          SOCIALS.map((SOCIAL) => (
            <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
              <span class="text-xs font-mono text-foreground/50 hover:text-foreground/80 transition-colors duration-200">
                {SOCIAL.NAME}
              </span>
            </Link>
          ))
        }
        <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
          <span
            class="text-xs font-mono text-foreground/50 hover:text-foreground/80 transition-colors duration-200"
          >
            {SITE.EMAIL}
          </span>
        </Link>
      </div>
    </footer>
  </Container>
</PageLayout>
