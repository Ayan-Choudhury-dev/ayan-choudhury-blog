---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate OG image path based on current route
const generateOGImagePath = (pathname: string) => {
  // Remove leading and trailing slashes, then create the OG image path
  const route = pathname.replace(/^\/|\/$/g, '');
  return `/og/${route}`;
};

const { title, description, image } = Astro.props;
const ogImage = image || generateOGImagePath(Astro.url.pathname);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<!-- DNS prefetch and preconnect for font CDN -->
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<!-- Preload critical fonts -->
<link
  rel="preload"
  href="https://cdn.jsdelivr.net/fontsource/fonts/inter:vf@latest/latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="https://cdn.jsdelivr.net/fontsource/fonts/merriweather:vf@latest/latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<script is:inline>
  (function () {
    var theme = localStorage.theme;
    var dark =
      theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (dark) document.documentElement.classList.add('dark');
    else document.documentElement.classList.remove('dark');
    // Set flag for React components to prevent animations on first load
    document.documentElement.setAttribute('data-first-load', 'true');
  })();
</script>
<style is:inline>
  /* Critical CSS: prevent link color flash */
  a {
    color: #e5775e;
    word-break: break-word;
  }
  a:visited {
    color: #e5775e;
  }

  /* Critical CSS: prevent header FOUC */
  header {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    top: 0;
    border: 2px solid transparent;
    background-color: rgba(245, 245, 244, 0.75);
    backdrop-filter: blur(12px);
    z-index: 50;
  }

  html.dark header {
    background-color: rgba(28, 25, 23, 0.25);
  }

  /* Prevent font swap flash */
  body {
    font-family:
      'Inter Variable',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }
</style>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/x-icon" href="/favicon-light.svg"> -->
<link rel="icon" type="image/x-icon" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.url)} />
<meta property="og:site_name" content="Dada's Sketchbook" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

<ViewTransitions />

<script>
  import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';
  document.addEventListener('astro:before-swap', (e) =>
    [
      ...(e as TransitionBeforeSwapEvent).newDocument.head.querySelectorAll('link[as="font"]'),
    ].forEach((link) => link.remove())
  );
</script>

<script is:inline>
  function init() {
    preloadTheme();
    onScroll();
    animate();
    setupEventListeners();
  }

  function animate() {
    const animateElements = document.querySelectorAll('.animate');

    animateElements.forEach((element, index) => {
      setTimeout(() => {
        element.classList.add('show');
      }, index * 150);
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add('scrolled');
    } else {
      document.documentElement.classList.remove('scrolled');
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });
  }

  function toggleTheme(dark) {
    const css = document.createElement('style');

    css.appendChild(
      document.createTextNode(
        `* {
             -webkit-transition: none !important;
             -moz-transition: none !important;
             -o-transition: none !important;
             -ms-transition: none !important;
             transition: none !important;
          }
        `
      )
    );

    document.head.appendChild(css);

    if (dark) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }

    window.getComputedStyle(css).opacity;
    document.head.removeChild(css);
  }

  function preloadTheme() {
    const userTheme = localStorage.theme;

    if (userTheme === 'light' || userTheme === 'dark') {
      if (userTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    } else {
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
  }

  function initFirstLoad() {
    document.documentElement.classList.add('no-entrance-transition');
    preloadTheme();
    onScroll();
    document.querySelectorAll('.animate').forEach(function (el) {
      el.classList.add('show');
    });
    setupEventListeners();
    // Wait for next frame to ensure all styles are applied, then remove transition suppression
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        document.documentElement.classList.remove('no-entrance-transition');
        // Remove first-load flag to enable animations for React components
        document.documentElement.removeAttribute('data-first-load');
      });
    });
  }

  function setupEventListeners() {
    const backToTop = document.getElementById('back-to-top');
    backToTop?.addEventListener('click', (event) => scrollToTop(event));

    const backToPrev = document.getElementById('back-to-prev');
    backToPrev?.addEventListener('click', () => window.history.back());

    const darkThemeButton = document.getElementById('dark-theme-button');
    darkThemeButton?.addEventListener('click', () => {
      localStorage.setItem('theme', 'dark');
      toggleTheme(true);
    });

    const rssbutton = document.getElementById('RSS-link-button');
    rssbutton?.addEventListener('click', () => {
      window.open('rss.xml', '_blank');
    });

    document.addEventListener('scroll', onScroll);
  }

  document.addEventListener('DOMContentLoaded', () => initFirstLoad());
  document.addEventListener('astro:after-swap', () => init());
  preloadTheme();
</script>
