---
import { cn } from "@lib/utils";

type Props = {
  href: string;
  external?: boolean;
  centered?: boolean;
};

const {
  href,
  external,
  centered = false,
  ...rest
} = Astro.props;
---

<a
  href={href}
  aria-label={href}
  target={external ? "_blank" : "_self"}
  class={cn(
    "inline-block text-current hover:text-black hover:dark:text-white transition-colors duration-200 ease-out",
    centered && "mx-auto"
  )}
  {...rest}
>
  <slot />
</a>
