---
import { SITE } from '@consts';

// Improved TypeScript types
interface PageInfo {
  currentPage: number;
  total: number;
  url: {
    prev: string;
    next: string;
  };
}

interface PaginationLink {
  url: string;
  page: number;
  isCurrent: boolean;
}

interface Props {
  page: PageInfo;
  post_num: number;
  paginationLinks: PaginationLink[];
}

const { page, post_num, paginationLinks } = Astro.props;

// Computed values
const isLastPage = page.currentPage >= Math.ceil(page.total / post_num);
const totalPages = Math.ceil(page.total / post_num);

// Helper functions
const getPreviousPageUrl = (currentPage: number, prevUrl: string) => 
  currentPage === 2 ? '/' : prevUrl;

const getPageUrl = (link: PaginationLink) => 
  link.page === 1 ? '/' : link.url;

// Component classes
const buttonBaseClasses = "relative inline-flex items-center rounded-full px-6 py-3 text-base font-medium transition-colors";
const activeButtonClasses = "bg-white/5 text-white/75 hover:bg-white/10 active:bg-white/15";
const disabledButtonClasses = "opacity-10 cursor-not-allowed text-gray-400";
const desktopButtonClasses = "relative inline-flex items-center rounded-r-md px-2 py-2 focus:z-20 focus:outline-offset-0";
const pageNumberClasses = (isCurrent: boolean) => 
  isCurrent
    ? 'relative z-10 inline-flex items-center rounded-full px-4 py-2 text-sm font-bold text-terracotta-600 focus:z-20'
    : 'relative inline-flex items-center px-4 py-2 text-sm font-medium text-gray-400 hover:text-terracotta-500';
---

<!-- Main pagination container -->
<div
  id="pagination-container"
  class="flex items-center justify-between px-4 py-3 sm:px-6 text-black/50 dark:text-white/75"
>
  <!-- Mobile pagination view -->
  <div id="mobile-pagination" class="flex flex-1 flex-col gap-4 sm:hidden">
    <!-- Mobile navigation buttons -->
    <div id="mobile-nav-buttons" class="flex justify-between items-center">
      <!-- Previous page arrow -->
      <a
        href={getPreviousPageUrl(page.currentPage, page.url.prev)}
        class={`${buttonBaseClasses} ${activeButtonClasses}`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-icon lucide-arrow-left">
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
      </a>
      
      <!-- Post count information for mobile -->
      <div id="mobile-post-count" class="text-center">
        <p class="text-sm text-white/40">
          <span class="font-medium text-terracotta-500">{page.currentPage}</span> / <span class="font-medium">{totalPages}</span>
        </p>
      </div>

      <!-- Next page arrow -->
      <a
        href={page.url.next}
        class={`${buttonBaseClasses} ${isLastPage ? disabledButtonClasses : activeButtonClasses}`}
        aria-disabled={isLastPage}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right-icon lucide-arrow-right">
          <path d="M5 12h14"/>
          <path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Desktop pagination view -->
  <div
    id="desktop-pagination"
    class="hidden flex-col gap-4 sm:flex sm:flex-1 sm:items-center sm:justify-between"
  >
    <!-- Post count information for desktop -->
    <div id="desktop-post-count">
      <p class="text-sm text-white/40">
        Showing
        <span class="font-medium">{page.currentPage * post_num - post_num + 1}</span>
        to
        <span class="font-medium">{page.currentPage * post_num - 1}</span>
        of
        <span class="font-medium">{page.total}</span>
        posts
      </p>
    </div>

    <!-- Desktop pagination navigation -->
    <div id="desktop-nav">
      <nav
        class="isolate inline-flex gap-2 -space-x-px rounded-md shadow-sm"
        aria-label="Pagination"
      >
        <!-- Previous page arrow -->
        <a
          href={getPreviousPageUrl(page.currentPage, page.url.prev)}
          class={`${desktopButtonClasses} dark:text-white hover:text-orange-400`}
        >
          <span class="sr-only">Previous</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </a>

        <!-- Page number links -->
        {
          paginationLinks.map((link) => (
            <a
              href={getPageUrl(link)}
              class={pageNumberClasses(link.isCurrent)}
            >
              {link.page}
            </a>
          ))
        }

        <!-- Next page arrow -->
        <a
          href={page.url.next}
          class={`${desktopButtonClasses} ${isLastPage ? disabledButtonClasses : 'dark:text-white hover:text-orange-400'}`}
          aria-disabled={isLastPage}
        >
          <span class="sr-only">Next</span>
          <svg
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
              clip-rule="evenodd"
            ></path>
          </svg>
        </a>
      </nav>
    </div>
  </div>
</div>
