{
  "name": "astro-nano",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "concurrently \"npm run watch:prettier\" \"npm run watch:dev\"",
    "watch:prettier": "onchange \"**/*.{js,ts,astro,mdx,json,css}\" -- prettier --write --ignore-unknown {{changed}}",
    "watch:dev": "astro dev --host",
    "dev": "astro dev --host",
    "dev:network": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/markdoc": "^2.1.3",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^7.1.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.12",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "~18.3.28",
    "@types/react-dom": "~18.3.7",
    "@typescript-eslint/eslint-plugin": "~7.18.0",
    "@typescript-eslint/parser": "~7.18.0",
    "@vercel/analytics": "^1.6.1",
    "astro": "^7.4.7",
    "astro-og-canvas": "^0.11.1",
    "canvaskit-wasm": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "eslint": "~8.57.1",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "framer-motion": "^12.16.0",
    "lucide-astro": "^0.556.0",
    "marked": "~15.0.12",
    "motion": "^12.38.0",
    "onchange": "^7.1.0",
    "oxc-transform-react": "^0.145.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "~2.6.1",
    "tailwindcss": "^4.3.5",
    "tippy.js": "^6.3.7",
    "typescript": "~5.9.3",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "fast-xml-parser": "^5.5.9",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1"
  },
  "patchedDependencies": {
    "@keystatic/core@0.6.9": "patches/@keystatic%2Fcore@0.6.9.patch"
  }
}
