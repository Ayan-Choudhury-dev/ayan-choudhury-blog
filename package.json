{
  "name": "astro-nano",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently \"npm run watch:prettier\" \"npm run watch:dev\"",
    "watch:prettier": "onchange \"**/*.{js,ts,astro,mdx,json,css}\" -- prettier --write --ignore-unknown {{changed}}",
    "watch:dev": "astro dev --host",
    "dev": "astro dev --host",
    "dev:network": "astro dev --host",
    "build": "astro check && astro build",
    "preview": "astro preview --host",
    "preview:network": "astro preview --host",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,astro,json,css}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdoc": "^0.15.7",
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/react": "^4.4.0",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@astrojs/ts-plugin": "^1.10.4",
    "@astrojs/vercel": "^8.2.8",
    "@fontsource/inter": "^5.0.17",
    "@fontsource/lora": "^5.0.16",
    "@keystatic/astro": "^5.0.0",
    "@keystatic/core": "^0.5.26",
    "@lucide/astro": "^0.513.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.14.1",
    "astro-icon": "^1.1.5",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^0.32.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "framer-motion": "^12.16.0",
    "lucide-astro": "^0.486.0",
    "lucide-react": "^0.513.0",
    "markdown-it": "^14.1.0",
    "marked": "^15.0.2",
    "node-html-parser": "^6.1.13",
    "onchange": "^7.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sanitize-html": "^2.13.1",
    "sharp": "^0.33.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tippy.js": "^6.3.7",
    "typescript": "^5.4.2",
    "vercel": "^39.0.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "prettier": "3.3.2",
    "prettier-plugin-astro": "^0.14.1"
  }
}
