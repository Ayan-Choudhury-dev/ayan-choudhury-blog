---
import { getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import MusicCard from '@components/MusicCard.astro';
import { AudioWaveform, List, LayoutGrid } from 'lucide-astro';

const tracks = (await getCollection('music'))
  .filter((track) => !track.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Music" description="My music collection">
  <Container>
    <div class="space-y-10">
      <div class="animate flex items-center justify-between">
        <div class="font-bold text-xl text-black dark:text-white">
          <AudioWaveform class="inline-block" />
          Playlist
        </div>
        <!-- View Toggle - Only visible on mobile -->
        <div class="md:hidden flex items-center gap-2">
          <button
            id="list-view-btn"
            class="p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors"
            aria-label="List view"
          >
            <List class="size-5" />
          </button>
          <button
            id="grid-view-btn"
            class="p-2 rounded-lg bg-white/5 hover:bg-white/10 transition-colors"
            aria-label="Grid view"
          >
            <LayoutGrid class="size-5" />
          </button>
        </div>
      </div>
      {
        tracks.length > 0 ? (
          <div id="music-container" class="animate">
            <!-- List View -->
            <ul id="list-view" class="flex flex-col gap-[3em]">
              {
                tracks.map((track) => (
                  <li>
                    <MusicCard entry={track} />
                  </li>
                ))
              }
            </ul>
            <!-- Grid View -->
            <div id="grid-view" class="hidden">
              <div class="relative">
                {
                  tracks.map((track, index) => (
                    <div 
                      class="absolute w-full transition-all duration-500 ease-out"
                      style={`transform: translateY(${index * 20}px); z-index: ${tracks.length - index};`}
                    >
                      <MusicCard entry={track} />
                    </div>
                  ))
                }
                {/* Spacer to account for stacked cards */}
                <div style={`height: ${tracks.length * 20 + 400}px`}></div>
              </div>
            </div>
          </div>
        ) : (
          <div class="animate flex flex-col items-center justify-center py-20">
            <div class="text-4xl font-bold text-black/10 dark:text-white/10 select-none">
              <span class="relative inline-block">
                <span class="relative z-10">No tracks yet</span>
                <span class="absolute inset-0 bg-gradient-to-b from-white/20 to-black/20 dark:from-white/10 dark:to-black/10 blur-sm -z-10"></span>
              </span>
            </div>
            <p class="mt-4 text-sm text-black/40 dark:text-white/40">Check back later for updates</p>
          </div>
        )
      }
    </div>
  </Container>
</PageLayout>

<script>
  // View toggle functionality
  const listViewBtn = document.getElementById('list-view-btn');
  const gridViewBtn = document.getElementById('grid-view-btn');
  const listView = document.getElementById('list-view');
  const gridView = document.getElementById('grid-view');
  const musicContainer = document.getElementById('music-container');

  // Set initial view based on screen size
  const setInitialView = () => {
    if (window.innerWidth < 768) { // md breakpoint
      listView?.classList.remove('hidden');
      gridView?.classList.add('hidden');
      listViewBtn?.classList.add('bg-white/10');
      gridViewBtn?.classList.remove('bg-white/10');
      musicContainer?.setAttribute('data-view', 'list');
    }
  };

  // Toggle between views
  listViewBtn?.addEventListener('click', () => {
    listView?.classList.remove('hidden');
    gridView?.classList.add('hidden');
    listViewBtn?.classList.add('bg-white/10');
    gridViewBtn?.classList.remove('bg-white/10');
    musicContainer?.setAttribute('data-view', 'list');
  });

  gridViewBtn?.addEventListener('click', () => {
    listView?.classList.add('hidden');
    gridView?.classList.remove('hidden');
    listViewBtn?.classList.remove('bg-white/10');
    gridViewBtn?.classList.add('bg-white/10');
    musicContainer?.setAttribute('data-view', 'grid');
  });

  // Set initial view on page load
  setInitialView();

  // Update view on window resize
  window.addEventListener('resize', setInitialView);

  // Handle scroll animation for grid view
  const handleScroll = () => {
    if (musicContainer?.getAttribute('data-view') === 'grid') {
      const cards = gridView?.querySelectorAll('.music-card');
      const scrollPosition = window.scrollY;
      
      cards?.forEach((card, index) => {
        const cardTop = card.getBoundingClientRect().top;
        const triggerPoint = window.innerHeight * 0.8;
        
        if (cardTop < triggerPoint) {
          card.style.transform = `translateY(${Math.max(0, scrollPosition * 0.1 - index * 20)}px)`;
        }
      });
    }
  };

  window.addEventListener('scroll', handleScroll);
</script>

<style>
  /* Add smooth transitions for view switching */
  #list-view, #grid-view {
    transition: opacity 0.3s ease-in-out;
  }

  /* Stacked card animations */
  .music-card {
    transition: transform 0.3s ease-out;
  }
</style> 