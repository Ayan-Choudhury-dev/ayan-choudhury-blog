---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate OG image path based on current route
const generateOGImagePath = (pathname: string) => {
  // Remove leading and trailing slashes, then create the OG image path
  const route = pathname.replace(/^\/|\/$/g, '');
  return `/og/${route}`;
};

const { title, description, image } = Astro.props;
const ogImage = image || generateOGImagePath(Astro.url.pathname);
---

<!-- THEME: Absolute first after <head>; executes before any paint to prevent flash -->
<script is:inline>
  // Execute immediately to prevent theme flash
  (function () {
    const storedTheme = localStorage.getItem('theme');
    const theme =
      storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (theme === 'dark') document.documentElement.classList.add('dark');
    document.documentElement.dataset.theme = theme;
  })();
</script>

<!-- Critical inline CSS: available instantly, prevents FOUC during initial load & view transitions -->
<style is:inline>
  /* Background colors: must be inline for both initial load and view transitions */
  html {
    background-color: #ede7de;
  }
  html.dark {
    background-color: #201f1d;
  }

  /* Animate elements: hidden until JS adds .show */
  .animate {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  .animate.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* Suppress transitions during DOM swap */
  html.no-entrance-transition *,
  html.no-entrance-transition *::before,
  html.no-entrance-transition *::after {
    transition: none !important;
    animation: none !important;
  }
  html.no-entrance-transition .animate {
    opacity: 1;
    transform: translateY(0);
  }

  /* Header: must be inline so it doesn't flash unstyled */
  header {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    top: 0;
    border: 2px solid transparent;
    border-bottom: 1px solid rgba(225, 119, 102, 0.12);
    background-color: rgba(247, 238, 227, 0.85);
    backdrop-filter: blur(12px);
    z-index: 50;
  }
  html.dark header {
    background-color: rgba(28, 25, 23, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* Prevent font swap flash */
  body {
    font-family:
      'Inter Variable',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
  }
</style>

<!-- Global Metadata -->
<meta charset="utf-8" />
<!-- DNS prefetch and preconnect for font CDN -->
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<!-- Preload critical fonts -->
<link
  rel="preload"
  href="https://cdn.jsdelivr.net/fontsource/fonts/inter:vf@latest/latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="https://cdn.jsdelivr.net/fontsource/fonts/merriweather:vf@latest/latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)">
<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)">
<link rel="icon" type="image/x-icon" href="/favicon-light.svg"> -->
<link rel="icon" type="image/x-icon" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.url)} />
<meta property="og:site_name" content="Dada's Sketchbook" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

<ClientRouter />

<script is:inline>
  // --- View Transition theme & FOUC prevention ---
  // Must be is:inline so handlers register synchronously before any navigation

  // BEFORE swap: prepare the incoming document so the first frame is correct
  document.addEventListener('astro:before-swap', function (e) {
    var isDark = document.documentElement.classList.contains('dark');

    // 1. Carry over theme class
    if (isDark) {
      e.newDocument.documentElement.classList.add('dark');
    } else {
      e.newDocument.documentElement.classList.remove('dark');
    }

    // 2. Suppress transitions during swap
    e.newDocument.documentElement.classList.add('no-entrance-transition');

    // 3. Pre-show all .animate elements so content doesn't flash invisible
    e.newDocument.querySelectorAll('.animate').forEach(function (el) {
      el.classList.add('show');
    });

    // 4. Remove font preload links (already cached)
    e.newDocument.head.querySelectorAll('link[as="font"]').forEach(function (link) {
      link.remove();
    });
  });

  // AFTER swap: safety net — re-apply theme on the live document before paint
  document.addEventListener('astro:after-swap', function () {
    var stored = localStorage.getItem('theme');
    var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = stored || (prefersDark ? 'dark' : 'light');

    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  });
</script>

<script is:inline>
  function init() {
    preloadTheme();
    onScroll();
    animate();
    setupEventListeners();
  }

  function animate() {
    const animateElements = document.querySelectorAll('.animate');

    animateElements.forEach((element, index) => {
      element.style.transitionDelay = `${index * 150}ms`;
      element.classList.add('show');
    });
  }

  function onScroll() {
    if (window.scrollY > 0) {
      document.documentElement.classList.add('scrolled');
    } else {
      document.documentElement.classList.remove('scrolled');
    }
  }

  function scrollToTop(event) {
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: 'smooth',
    });
  }

  function toggleTheme(dark) {
    const html = document.documentElement;

    // Add transition class before changing theme
    html.classList.add('theme-transitioning');

    if (dark) {
      html.classList.add('dark');
    } else {
      html.classList.remove('dark');
    }

    // Remove transition class after animation completes
    setTimeout(() => {
      html.classList.remove('theme-transitioning');
    }, 300);
  }

  function preloadTheme() {
    var userTheme = localStorage.theme;
    var theme =
      userTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  }

  function updateThemeButtons() {
    var isDark = document.documentElement.classList.contains('dark');
    var lightBtn = document.getElementById('light-theme-button');
    var darkBtn = document.getElementById('dark-theme-button');
    if (lightBtn) {
      if (isDark) {
        lightBtn.classList.remove('hidden');
        lightBtn.classList.add('flex');
      } else {
        lightBtn.classList.add('hidden');
        lightBtn.classList.remove('flex');
      }
    }
    if (darkBtn) {
      if (isDark) {
        darkBtn.classList.add('hidden');
        darkBtn.classList.remove('flex');
      } else {
        darkBtn.classList.remove('hidden');
        darkBtn.classList.add('flex');
      }
    }
  }

  function initFirstLoad() {
    document.documentElement.classList.add('no-entrance-transition');
    preloadTheme();
    updateThemeButtons();
    onScroll();
    document.querySelectorAll('.animate').forEach(function (el) {
      el.classList.add('show');
    });
    setupEventListeners();
    // Wait for next frame to ensure all styles are applied, then remove transition suppression
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        document.documentElement.classList.remove('no-entrance-transition');
        // Remove first-load flag to enable animations for React components
        document.documentElement.removeAttribute('data-first-load');
      });
    });
  }

  function setupEventListeners() {
    const backToTop = document.getElementById('back-to-top');
    backToTop?.addEventListener('click', (event) => scrollToTop(event));

    const backToPrev = document.getElementById('back-to-prev');
    backToPrev?.addEventListener('click', () => window.history.back());

    var darkThemeButton = document.getElementById('dark-theme-button');
    darkThemeButton?.addEventListener('click', function () {
      localStorage.setItem('theme', 'dark');
      toggleTheme(true);
      updateThemeButtons();
    });

    var lightThemeButton = document.getElementById('light-theme-button');
    lightThemeButton?.addEventListener('click', function () {
      localStorage.setItem('theme', 'light');
      toggleTheme(false);
      updateThemeButtons();
    });

    const rssbutton = document.getElementById('RSS-link-button');
    rssbutton?.addEventListener('click', () => {
      window.open('rss.xml', '_blank');
    });

    document.removeEventListener('scroll', onScroll);
    document.addEventListener('scroll', onScroll);
  }

  // Use astro:page-load instead of DOMContentLoaded or astro:after-swap
  document.addEventListener('astro:page-load', () => {
    initFirstLoad();
  });

  preloadTheme();
  updateThemeButtons();
</script>
