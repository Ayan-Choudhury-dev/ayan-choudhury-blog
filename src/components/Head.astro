---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Generate OG image path based on current route
const generateOGImagePath = (pathname: string) => {
  // Remove leading and trailing slashes, then create the OG image path
  const route = pathname.replace(/^\/|\/$/g, '');
  return `/og/${route}`;
};

const { title, description, image } = Astro.props;
const ogImage = image || generateOGImagePath(Astro.url.pathname);
---

<!-- THEME: Absolute first after <head>; executes before any paint to prevent flash -->
<script is:inline>
  (function () {
    const storedTheme = localStorage.getItem('theme');
    const theme =
      storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    if (theme === 'dark') document.documentElement.classList.add('dark');
    document.documentElement.dataset.theme = theme;
  })();
</script>

<!-- Critical inline CSS: available instantly, prevents FOUC during initial load & view transitions -->
<style is:inline>
  html {
    /* Warm cream background — matches global.css :root --background */
    background-color: rgb(237, 231, 222);
    /* Correct text color so it doesn't default to black-on-white flash */
    color: rgb(63, 84, 110);
  }
  html.dark {
    background-color: rgb(32, 31, 29);
    color: rgb(235, 235, 235);
  }

  /*
   * THE MAIN FOUC FIX:
   * Reset ALL anchor tags to inherit the text color of their parent instead of
   * showing the browser default blue. This must live in the inline critical CSS
   * so it is applied BEFORE the async Tailwind stylesheet loads.
   * The global.css rule `a { @apply text-accent-color }` overrides this once loaded.
   */
  a {
    color: inherit;
    text-decoration: none;
  }

  /*
   * SVG FOUC FIX:
   * The arrow in ArrowCard uses `stroke-current`. Without this reset, browsers
   * fall back to the default blue link color during the FOUC window.
   */
  svg {
    stroke: currentColor;
  }

  body {
    font-family: 'Geist Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background-color: rgb(237, 231, 222);
  }
  html.dark body {
    background-color: rgb(32, 31, 29);
  }

  @keyframes fade-in-up {
    0% { opacity: 0; transform: translateY(10px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate {
    opacity: 0;
    animation: fade-in-up 0.6s ease-out forwards;
    animation-play-state: paused;
  }

  [data-animate-index] { animation-play-state: running; }
  [data-animate-index="0"] { animation-delay: 0ms; }
  [data-animate-index="1"] { animation-delay: 150ms; }
  [data-animate-index="2"] { animation-delay: 300ms; }
  [data-animate-index="3"] { animation-delay: 450ms; }
  [data-animate-index="4"] { animation-delay: 600ms; }
  [data-animate-index="5"] { animation-delay: 750ms; }
  [data-animate-index="6"] { animation-delay: 900ms; }

  /* Header critical styles — must match global.css exactly */
  header {
    position: fixed;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    padding-top: 1.25rem;
    padding-bottom: 1.25rem;
    top: 0;
    border-bottom: 1px solid rgba(225, 119, 102, 0.12);
    background-color: rgba(247, 238, 227, 0.85);
    backdrop-filter: blur(12px);
    z-index: 50;
  }
  html.dark header {
    background-color: rgba(28, 25, 23, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /*
   * HEADER PERSIST FIX:
   * The header uses transition:persist so it stays in the DOM across navigations.
   * The .animate class sets opacity:0 with a paused animation until JS assigns
   * data-animate-index. Without this rule, any .animate element inside the header
   * would flash invisible on page load. Force full visibility for all header content.
   */
  header, header * {
    opacity: 1 !important;
    animation: none !important;
    transform: none !important;
  }
</style>

<!-- Global Metadata -->
<meta charset="utf-8" />
<link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

<!-- Preload critical fonts (Geist as defined in tailwind.config.mjs) -->
<link
  rel="preload"
  href="https://cdn.jsdelivr.net/fontsource/fonts/geist:vf@latest/latin-wght-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/x-icon" href="/favicon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- OG / Twitter -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImage, Astro.url)} />
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:image" content={new URL(ogImage, Astro.url)} />

<ClientRouter />

<script is:inline>
  // theme and FOUC prevention logic
  function applyTheme() {
    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const theme = stored || (prefersDark ? 'dark' : 'light');
    document.documentElement.classList.toggle('dark', theme === 'dark');
    document.documentElement.dataset.theme = theme;
  }

  function initAnimations() {
    // Only assign animate indices to elements that haven't been initialized yet.
    // This prevents re-triggering (opacity:0 flash) on elements that are already
    // visible — particularly important for transition:persist elements like the header.
    let index = 0;
    document.querySelectorAll('.animate').forEach((el) => {
      // Skip elements already assigned (persisted across view transitions)
      // and skip anything inside the header (it persists and should not re-animate)
      if (el.hasAttribute('data-animate-index') || el.closest('header')) return;
      (el as HTMLElement).dataset.animateIndex = index.toString();
      index++;
    });
  }

  function setupHeader() {
    const onScroll = () => {
      document.documentElement.classList.toggle('scrolled', window.scrollY > 0);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Initialize on first load and every navigation
  document.addEventListener('astro:page-load', () => {
    applyTheme();
    initAnimations();
    setupHeader();
    
    // Setup theme toggles
    document.getElementById('dark-theme-button')?.addEventListener('click', () => {
      localStorage.setItem('theme', 'dark');
      applyTheme();
    });
    document.getElementById('light-theme-button')?.addEventListener('click', () => {
      localStorage.setItem('theme', 'light');
      applyTheme();
    });
  });

  // Ensure theme is applied IMMEDIATELY during swap to prevent flash
  document.addEventListener('astro:before-swap', (e) => {
    const isDark = document.documentElement.classList.contains('dark');
    e.newDocument.documentElement.classList.toggle('dark', isDark);
  });
</script>
