    <div class="flex flex-col items-center gap-4">
      <div class="font-semibold text-accent-color">
        &copy; {year}
        {SITE.AUTHOR}
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://pages.cloudflare.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 font-semibold fill-accent-color hover:text-foreground/80 transition-colors duration-300"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            xmlns="http://www.w3.org/2000/svg"
            class=""
