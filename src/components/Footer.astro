---
import Container from '@components/Container.astro';
import { SITE } from '@consts';

const year = new Date().getFullYear();
---

<footer class="animate">
  <Container>
    <!-- <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div> -->
    <div class="flex flex-col items-center gap-4">
      <div class="font-semibold text-foreground/60">
        &copy; {year}
        {SITE.AUTHOR}
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://vercel.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 font-semibold text-foreground/60 hover:text-foreground/80 transition-colors duration-300"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 76 65"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="text-foreground/60"
          >
            <path d="M37.5274 0L75.0548 65H0L37.5274 0Z" fill="currentColor"></path>
          </svg>
          Deployed on Vercel
        </a>
        <a
          href="https://astro.build"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 font-semibold text-foreground/60 hover:text-foreground/80 transition-colors duration-300"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 128 128"
            class="w-6 h-6 text-stone-400 dark:text-zinc-600"
            ><defs
              ><linearGradient
                id="a"
                x1="882.997"
                x2="638.955"
                y1="27.113"
                y2="866.902"
                gradientTransform="scale(.1)"
                gradientUnits="userSpaceOnUse"
                ><stop offset="0" stop-color="currentColor"></stop><stop
                  offset="1"
                  stop-color="currentColor"></stop></linearGradient
              ><linearGradient
                id="b"
                x1="1001.68"
                x2="790.326"
                y1="652.45"
                y2="1094.91"
                gradientTransform="scale(.1)"
                gradientUnits="userSpaceOnUse"
                ><stop offset="0" stop-color="currentColor"></stop><stop
                  offset="1"
                  stop-color="currentColor"
                  stop-opacity="0"></stop></linearGradient
              ></defs
            ><path
              fill="currentColor"
              d="M81.504 9.465c.973 1.207 1.469 2.836 2.457 6.09l21.656 71.136a90.079 90.079 0 0 0-25.89-8.765L65.629 30.28a1.833 1.833 0 0 0-3.52.004L48.18 77.902a90.104 90.104 0 0 0-26.003 8.778l21.758-71.14c.996-3.25 1.492-4.876 2.464-6.083a8.023 8.023 0 0 1 3.243-2.398c1.433-.575 3.136-.575 6.535-.575H71.72c3.402 0 5.105 0 6.543.579a7.988 7.988 0 0 1 3.242 2.402Zm0 0"
            ></path><path
              fill="currentColor"
              d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Zm0 0"
            ></path><path
              fill="currentColor"
              d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Zm0 0"
            ></path></svg
          >

          Built with Astro
        </a>
      </div>
    </div>
  </Container>
</footer>
