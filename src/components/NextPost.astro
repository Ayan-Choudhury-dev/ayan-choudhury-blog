---
import type { CollectionEntry } from 'astro:content';
import { readingTime, shouldOptimizeImage } from '@lib/utils';
import Image from 'astro/components/Image.astro';

type Props = {
  nextPost: CollectionEntry<'blog'>;
};

const { nextPost } = Astro.props;

const useOptimizedImage =
  nextPost.data.cover && typeof nextPost.data.cover === 'object' && 'src' in nextPost.data.cover
    ? shouldOptimizeImage(nextPost.data.cover.src)
    : true;
---

<div class="next-post-section">
  <a
    href={`/blog/${nextPost.slug}`}
    class="next-post-link group"
    aria-label={`Read next: ${nextPost.data.title}`}
  >
    <!-- Card -->
    <div class="next-post-card" id="NextPost">
      <!-- Image -->
      <div class="next-post-image-col">
        {
          nextPost.data.cover && 'src' in nextPost.data.cover ? (
            useOptimizedImage ? (
              <Image
                src={nextPost.data.cover}
                quality="mid"
                width={400}
                height={300}
                class="next-post-img"
                alt={nextPost.data.title}
              />
            ) : (
              <img
                src={nextPost.data.cover.src}
                width="400"
                height="300"
                class="next-post-img"
                alt={nextPost.data.title}
              />
            )
          ) : (
            <img
              src="https://images.unsplash.com/photo-1512236258305-32fb110fdb01?w=800&auto=format&fit=crop&q=60"
              width="400"
              height="300"
              class="next-post-img"
              alt=""
              aria-hidden="true"
            />
          )
        }
      </div>

      <!-- Content -->
      <div class="next-post-content">
        <p class="next-post-kicker text-xs">Read next</p>
        <h3 class="next-post-title">{nextPost.data.title}</h3>
        <div class="next-post-meta">
          <span class="next-post-time text-sm">{readingTime(nextPost.body)}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="next-post-arrow"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </div>
      </div>
    </div>
  </a>
</div>

<style>
  .next-post-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .next-post-link {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    color: inherit;
  }

  /* Card shell */
  .next-post-card {
    flex: 1;
    display: flex;
    height: 200px;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid var(--border);
    background-color: var(--card);
    position: relative;
    transition:
      border-color 350ms ease,
      box-shadow 350ms ease;
  }

  /* Animated accent hairline on bottom */
  .next-post-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background-color: var(--color-accent);
    transition: width 450ms cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 0 0 0.75rem 0.75rem;
  }

  .group:hover .next-post-card {
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--border));
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.07);
  }

  .group:hover .next-post-card::after {
    width: 100%;
  }

  /* Image column */
  .next-post-image-col {
    width: 38%;
    max-width: 210px;
    flex-shrink: 0;
    overflow: hidden;
    position: relative;
  }

  .next-post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 550ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .group:hover .next-post-img {
    transform: scale(1.05);
  }

  /* Content */
  .next-post-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1.75rem;
    gap: 0.5rem;
    min-width: 0;
  }

  /* "Read next" kicker */
  .next-post-kicker {
    font-family: 'Inter Variable', sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin: 0;
    opacity: 0.8;
  }

  /* Title */
  .next-post-title {
    font-family: 'Merriweather Variable', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-accent);
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 300ms ease;
  }

  /* Meta row */
  .next-post-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.25rem;
  }

  .next-post-time {
    font-family: 'Inter Variable', sans-serif;
    letter-spacing: 0.03em;
    color: var(--foreground);
    opacity: 0.45;
  }

  .next-post-arrow {
    width: 1rem;
    height: 1rem;
    color: var(--foreground);
    transform: translateX(0);
    transition:
      transform 300ms ease,
      opacity 300ms ease,
      color 300ms ease;
    flex-shrink: 0;
  }

  .group:hover .next-post-arrow {
    transform: translateX(5px);
    opacity: 1;
    color: var(--color-accent);
  }

  /* Dark mode */
  :global(html.dark) .next-post-card {
    background-image: var(--noise-texture);
  }

  :global(html.dark) .group:hover .next-post-card {
    box-shadow: 0 8px 36px rgba(0, 0, 0, 0.45);
  }

  /* Mobile */
  @media (max-width: 540px) {
    .next-post-card {
      height: 160px;
    }

    .next-post-image-col {
      width: 36%;
    }

    .next-post-content {
      padding: 1.125rem 1.25rem;
    }

    .next-post-title {
      font-size: 1rem;
      -webkit-line-clamp: 4;
    }
  }
</style>
