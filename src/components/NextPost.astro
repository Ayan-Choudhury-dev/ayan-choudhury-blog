---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '@lib/utils';
import Image from 'astro/components/Image.astro';
import fs from 'node:fs';
import path from 'node:path';

type Props = {
  nextPost: CollectionEntry<'blog'>;
};

const { nextPost } = Astro.props;
const { Content } = await nextPost.render();

let useOptimizedImage = true;
const LIMIT = 4 * 1024 * 1024; // 4MB

if (
  nextPost.data.cover &&
  typeof nextPost.data.cover === 'object' &&
  'src' in nextPost.data.cover
) {
  try {
    const src = nextPost.data.cover.src;
    const isAnimated = src.toLowerCase().endsWith('.gif') || src.toLowerCase().endsWith('.webp');

    if (isAnimated) {
      useOptimizedImage = false;
    } else {
      let filePath = '';
      if (src.startsWith('/@fs')) {
        filePath = src.replace('/@fs', '').split('?')[0];
      } else if (src.startsWith('/src')) {
        filePath = path.join(process.cwd(), src.split('?')[0]);
      } else if (src.startsWith('/') && !src.startsWith('http')) {
        filePath = path.join(process.cwd(), src.split('?')[0]);
      }

      if (filePath && fs.existsSync(filePath)) {
        const stats = fs.statSync(filePath);
        useOptimizedImage = stats.size < LIMIT;
      }
    }
  } catch (e) {
    useOptimizedImage = true;
  }
}
---

<div class="mt-16 border-t border-gray-200 dark:border-gray-800 pt-8">
  <h2 class="text-sm tracking-wider uppercase text-gray-500 dark:text-gray-400 mb-6 font-sans">
    Read next
  </h2>
  <!-- Component goes brr -->
  <div
    id="NextPost"
    class="flex shadow-zinc-950 shadow-2xl dark:border-zinc-900 rounded-xl overflow-hidden border border-gray-300 dark:border-gray-700"
  >
    <a href={`/blog/${nextPost.slug}`} class="group no-underline md:w-full">
      <!-- Container -->
      <div class="flex flex-col md:flex-1 md:flex-row md:h-[240px]">
        <div class="relative w-full h-full aspect-[16/9] md:aspect-auto overflow-hidden md:p-4">
          <div class="md:rounded-lg overflow-clip h-full">
            {
              nextPost.data.cover && 'src' in nextPost.data.cover ? (
                useOptimizedImage ? (
                  <Image
                    src={nextPost.data.cover}
                    quality={'mid'}
                    width={800}
                    height={450}
                    class=" object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500 ease-in-out rounded-none"
                    alt={nextPost.data.title}
                  />
                ) : (
                  <img
                    src={nextPost.data.cover.src}
                    width="800"
                    height="450"
                    class=" object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500 ease-in-out rounded-none"
                    alt={nextPost.data.title}
                  />
                )
              ) : (
                <Image
                  src="https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=900&auto=format&fit=crop&q=60&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTF8fGdyYWRpZW50fGVufDB8fDB8fHww"
                  quality={'mid'}
                  width={800}
                  height={450}
                  class=" object-cover w-full h-full transform group-hover:scale-105 transition-transform duration-500 ease-in-out rounded-none"
                  alt={nextPost.data.title}
                />
              )
            }
          </div>
        </div>
        <!-- Heading -->
        <div class="flex flex-col justify-between p-6 gap-4 md:p-8 md:w-full h-full">
          <h3 class="dark:text-terracotta-500 font-normal child:font-serif text-xl m-0">
            {nextPost.data.title}
          </h3>
          <!-- Text  -->
          <div
            class="flex items-center justify-between prose font-normal font-sans dark:prose-invert max-w-none line-clamp-2"
          >
            {readingTime(nextPost.body)}
            <!-- <Content /> -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-5"
            >
              <path
                fill-rule="evenodd"
                d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
        </div>
      </div>
    </a>
  </div>
</div>

