---
import { type CollectionEntry, getCollection } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/Container.astro';
import PostHeader from '@components/PostHeader.astro';
import TagLinks from '@components/TagLinks.astro';
import NextPost from '@components/NextPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, index) => {
    // Get the next post (if available)
    const nextPost = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { slug: post.slug },
      props: { post, nextPost },
    };
  });
}

type Props = {
  post: CollectionEntry<'blog'>;
  nextPost: CollectionEntry<'blog'> | null;
};

const { post, nextPost } = Astro.props;
const { Content } = await post.render();

// Ensure description is always a string
const description = post.data.description || '';

// Get cover image if it exists
const coverImage = post.data.cover?.src;
---

<PageLayout title={post.data.title} description={description} image={coverImage}>
  <Container>
    <!-- <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div> -->

    <PostHeader entry={post} />

    <!-- Content of blog begins here -->
    <article class="px-4 mb-16 prose-lg">
      <Content />
      <TagLinks post={post} />
    </article>
    {
      nextPost && (
        <div class="px-4 mb-16">
          <NextPost nextPost={nextPost} />
        </div>
      )
    }
  </Container>
</PageLayout>

