---
// Component Imports
import type { CollectionEntry } from 'astro:content';
import PostHeaderMini from './PostHeaderMini.astro';
import TagLinks from './TagLinks.astro';

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<div
  id="Postcard"
  class="animate mb-2 shadow-black/10 dark:shadow-zinc-950 shadow-2xl overflow-hidden bg-card rounded-2xl border border-border"
>
  <PostHeaderMini entry={entry} />
  <article class="px-4 sm:px-[50px] mb-8 lg:mb-10">
    <!-- Concatinated content -->
    <div class="prose dark:prose-invert max-w-none line-clamp-6">
      <Content />
    </div>

    <!-- <TagLinks post={entry} /> -->

    <button
      onclick={`window.location.href = '/${entry.collection}/${entry.slug}'`}
      class="animate mt-8 px-4 py-1 border border-foreground/20 text-foreground rounded-md hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
    >
      Continue reading
    </button>
  </article>
</div>
