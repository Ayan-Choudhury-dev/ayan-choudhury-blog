---
// Component Imports
import FormattedDate from './FormattedDate.astro';
import { readingTime, shouldOptimizeImage } from '@lib/utils';
import type { CollectionEntry } from 'astro:content';
import Image from 'astro/components/Image.astro';

type Props = {
  entry: CollectionEntry<'blog'>;
};

const { entry } = Astro.props;

const useOptimizedImage =
  entry.data.cover && typeof entry.data.cover === 'object' && 'src' in entry.data.cover
    ? shouldOptimizeImage(entry.data.cover.src)
    : true;
---

<div id="header_container">
  {
    entry.data.cover && 'src' in entry.data.cover && (
      <div id="Cover" class="rounded-t-lg">
        <div id="cover-container">
          {useOptimizedImage ? (
            <Image
              src={entry.data.cover}
              quality={'mid'}
              width={'800'}
              class=" rounded-t-lg w-full h-auto object-cover"
              alt={entry.data.title}
            />
          ) : (
            <img
              src={entry.data.cover.src}
              width="800"
              class=" rounded-t-lg w-full h-auto object-cover"
              alt={entry.data.title}
            />
          )}
        </div>
      </div>
    )
  }

  <div id="meta" class="px-4 sm:px-[50px] pt-4 md:pt-8">
    <div
      class="dark:text-terracotta-500 mb-4 text-black child:font-serif child:font-normal text-2xl"
    >
      <a href={`/${entry.collection}/${entry.slug}`} class="no-underline">
        {entry.data.title}
      </a>
    </div>

    <!-- <div class="text-sm animate text-gray-400 italic mt-2 mb-3">
    {entry.data.description}
  </div> -->

    <div
      class="flex items-center gap-3 text-black/60 dark:text-white/60 border-b border-dashed border-black/10 dark:border-white/10 pb-4"
    >
      <div class="font-base text-sm">
        <FormattedDate date={entry.data.date} />
      </div>
      &bull;
      <div class="font-base text-sm">
        {readingTime(entry.body)}
      </div>
    </div>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="absolute top-1/2 right-2 -translate-y-1/2 size-5 stroke-2 fill-none stroke-current"
    >
      <line
        x1="5"
        y1="12"
        x2="19"
        y2="12"
        class="translate-x-3 group-hover:translate-x-0 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 ease-in-out"
      ></line>
      <!-- <polyline
      points="12 5 19 12 12 19"
      class="-translate-x-1 group-hover:translate-x-0 transition-transform duration-300 ease-in-out"
    ></polyline> -->
    </svg>
  </div>
</div>

